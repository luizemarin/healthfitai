# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_ vão dentro do app: nunca coloque segredos aqui.

# Base da API usada pelo client.
# Deixe vazio em dev: o app usa o mesmo IP da máquina que roda o Expo, na porta 3333
# (funciona no simulador, no emulador e no celular na mesma rede Wi-Fi).
# Preencha para apontar para outro servidor (ex.: homologação).
EXPO_PUBLIC_API_URL=
