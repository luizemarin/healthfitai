# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_ vão dentro do app: nunca coloque segredos aqui.

# Base da API usada pelo client.
# Deixe vazio em dev: o app usa o mesmo IP da máquina que roda o Expo, na porta 3333
# (funciona no simulador, no emulador e no celular na mesma rede Wi-Fi).
# Preencha para apontar para outro servidor (ex.: homologação).
EXPO_PUBLIC_API_URL=

# PROVISÓRIO até o login do aluno trazer esses dados no token (BE-AUT-01): as rotas do aluno ainda
# pedem o id do aluno na URL e o do profissional no header X-Profissional-Id.
# Aluno: cadastre no painel web e copie o id da URL da ficha (/alunos/<id>).
EXPO_PUBLIC_ALUNO_ID=
# Profissional: vazio em dev usa o mesmo id padrão do painel web (VITE_PROFISSIONAL_ID).
EXPO_PUBLIC_PROFISSIONAL_ID=

# PROVISÓRIO até o login existir na API (BE-AUT-01): "true" pula a tela de login em dev para ver as
# telas do aluno. Ignorado em build de produção. Depois de mudar, reinicie com `npx expo start -c`.
EXPO_PUBLIC_SKIP_LOGIN=
