{
  "name": "@healthfitai/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../api/openapi.json -o src/api/generated/schema.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "expo": "58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "nativewind": "4.2.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
