{
  "expo": {
    "name": "HealthFitAI",
    "slug": "healthfitai",
    "version": "0.1.0",
    "scheme": "healthfitai",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#081225",
    "ios": {
      "bundleIdentifier": "com.healthfitai.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.healthfitai.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081225"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O HealthFitAI usa a câmera para você tirar as fotos de evolução pedidas pelo seu treinador.",
          "photosPermission": "O HealthFitAI acessa suas fotos para você escolher as fotos de evolução pedidas pelo seu treinador.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
