# Copie para .env e ajuste. Variáveis com prefixo VITE_ vão para o navegador: nunca coloque segredos aqui.

# Base da API usada pelo client. Em dev, "/api" passa pelo proxy do Vite (sem CORS).
VITE_API_URL=/api

# Para onde o proxy do Vite encaminha "/api" em dev (só usado pelo vite.config.ts).
API_PROXY_TARGET=http://localhost:3333
