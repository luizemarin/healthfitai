# Copie para .env e ajuste. Todas as variáveis são validadas na inicialização (src/config/env.ts).

# development | test | production
NODE_ENV=development

# Endereço e porta HTTP
HOST=0.0.0.0
PORT=3333

# Convite do aluno (BE-ALU-04): página que abre o link e validade do link em horas.
CONVITE_URL_BASE=http://localhost:8081/convite
CONVITE_VALIDADE_HORAS=168

# Banco de dados.
# Local (padrão): Postgres do docker-compose.yml na raiz -> npm run db:up
DATABASE_URL=postgresql://user:user@localhost:5432/healthfitai?schema=public
# Neon (homologação/produção): use a connection string DIRETA (sem "-pooler" no host) para migrations.
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/healthfitai?sslmode=require

# Fotos (BE-FOT-02): storage compatível com S3 — Cloudflare R2, bucket PRIVADO.
# Sem as 4 primeiras a API sobe, mas envio/visualização de fotos respondem 503.
# R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com; chaves em R2 > Manage API tokens
# (permissão Object Read & Write só neste bucket). No bucket, configure:
#   - CORS: PUT e GET liberados para as origens do painel/app, header Content-Type;
#   - Lifecycle: apagar objetos com prefixo "envios/" após 1 dia (envios não confirmados).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Maior arquivo aceito no envio (MB) e validade das URLs para ver as fotos (60 a 300 s).
FOTO_TAMANHO_MAXIMO_MB=10
FOTO_URL_VALIDADE_SEGUNDOS=300
