# Copie para .env e ajuste. Todas as variáveis são validadas na inicialização (src/config/env.ts).

# development | test | production
NODE_ENV=development

# Endereço e porta HTTP
HOST=0.0.0.0
PORT=3333

# Convite do aluno (BE-ALU-04): página que abre o link e validade do link em horas.
CONVITE_URL_BASE=http://localhost:8081/convite
CONVITE_VALIDADE_HORAS=168

# Banco de dados.
# Local (padrão): Postgres do docker-compose.yml na raiz -> npm run db:up
DATABASE_URL=postgresql://user:user@localhost:5432/healthfitai?schema=public
# Neon (homologação/produção): use a connection string DIRETA (sem "-pooler" no host) para migrations.
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/healthfitai?sslmode=require
